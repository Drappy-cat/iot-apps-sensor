# ==============================================================================
# KONFIGURASI SERVER RELAY ESP32-CAM (HYBRID MQTT + WEBSOCKET)
# ==============================================================================

# Port HTTP & WebSocket Server (Express & WS berjalan di port yang sama)
PORT=5000

# URL Broker MQTT:
# Contoh 1 (EMQX Public Broker - Siap pakai tanpa daftar):
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883

# Contoh 2 (HiveMQ Cloud Free Broker dengan TLS):
# MQTT_BROKER_URL=mqtts://your-instance.s1.eu.hivemq.cloud:8883

# Kredensial MQTT (Kosongkan jika broker publik tanpa autentikasi)
MQTT_USERNAME=
MQTT_PASSWORD=

# Topik MQTT Sesuai Spesifikasi Sistem
MQTT_TOPIC_CMD=tanaman/cam/cmd
MQTT_TOPIC_STATUS=tanaman/cam/status

# ==============================================================================
# KONFIGURASI SUPABASE STORAGE (OPSIONAL: UNTUK TIMELAPSE FOTO CLOUD)
# ==============================================================================
# Dapatkan dari: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_BUCKET=timelapse-tanaman


